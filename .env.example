# Copy this file to .env and fill in real local values.
# Never commit .env or any file containing a real API key.

OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Optional. The app defaults to data/chip_selector.sqlite3.
# DATABASE_URL=sqlite:///F:/code/chip-selector-agent/data/chip_selector.sqlite3
